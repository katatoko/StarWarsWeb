@page "/characters"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@using DTOs
@using StarWarsWeb.Client.Utils

@inject HttpClient Http
@inject NavigationManager Navigation
@inject UserState UserState

<PageTitle>Personajes de Star Wars</PageTitle>

<div class="container mt-4 mb-5">
    <div>
        <h1 class="fw-bold mb-1" style="color: #ffe81f; letter-spacing: 1px;">Archivos Jedi</h1>
        <p class="small" style="color: #d4d4d8;">
            Acceso concedido a: <strong style="color: #ffe81f;">@(UserState.FullName ?? "Oficial de la Alianza")</strong>
        </p>
    </div>

    @if (cargando)
    {
        <div class="text-center my-5 py-5">
            <div class="spinner-border text-warning" role="status" style="width: 3.5rem; height: 3.5rem;"></div>
            <p class="mt-3 text-light fw-bold">Descifrando datos desde la red SWAPI...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger" role="alert">
            @mensajeError
        </div>
    }
    else if (personajes == null || !personajes.Any())
    {
        <div class="alert alert-info">No se encontraron personajes disponibles.</div>
    }
    else
    {
        <!-- Grid de tarjetas de personajes con avatar galáctico -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var personaje in personajes)
            {
                var id = ObtenerIdDeUrl(personaje.Url);

                <div class="col">
                    <div class="card h-100 shadow text-white" style="background: #181818; border: 1px solid #333; border-radius: 12px; transition: all 0.3s;">
                        <div class="card-body p-4 text-center">
                            
                            <!-- Avatar más grande y centrado (105px) sin colisión de estilos -->
                            <div class="mb-3 d-flex justify-content-center">
                                <img src="@($"https://localhost:7155/api/FilesManagement/{id}")"
                                     alt="@personaje.Name"
                                     class="rounded-circle shadow"
                                     style="display: none; width: 300px; height: 300px; object-fit: cover; border: 3px solid #ffe81f;"
                                     onload="this.style.display='block'; var def = document.getElementById('avatar-@id'); if(def) def.style.display='none';"
                                     onerror="this.style.display='none'; var def = document.getElementById('avatar-@id'); if(def) def.style.display='flex';" />

                                <div id="avatar-@id"
                                     class="justify-content-center align-items-center rounded-circle shadow" 
                                     style="display: flex; width: 300px; height: 300px; background: linear-gradient(135deg, #2b2b2b 0%, #111 100%); border: 3px solid #ffe81f; color: #ffe81f; font-size: 2.2rem; font-weight: bold;">
                                    @(string.IsNullOrEmpty(personaje.Name) ? "SW" : personaje.Name.Substring(0, 1))
                                </div>
                            </div>

                            <h5 class="card-title fw-bold mb-3" style="color: #ffe81f;">@personaje.Name</h5>
                            
                            <div class="text-start p-3 rounded mb-3" style="background: #222;">
                                <p class="card-text mb-1 small"><strong style="color: #ffe81f;">Género:</strong> <span class="text-white">@(personaje.Gender ?? "Desconocido")</span></p>
                                <p class="card-text mb-1 small"><strong style="color: #ffe81f;">Nacimiento:</strong> <span class="text-white">@(personaje.BirthYear ?? "N/A")</span></p>
                                <p class="card-text mb-0 small"><strong style="color: #ffe81f;">Estatura:</strong> <span class="text-white">@(personaje.Height ?? "N/A") cm</span></p>
                            </div>
                            
                            <a href="@($"/character/{id}")" class="btn w-100 fw-bold py-2" style="background-color: #ffe81f; color: #000; border-radius: 8px;">
                                Ver Ficha Completa ➜
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Control de Paginación -->
        <div class="d-flex justify-content-center align-items-center gap-3 my-5">
            <button class="btn btn-outline-warning fw-bold px-4 py-2"
                    disabled="@(!tieneAnterior)"
                    @onclick="() => CambiarPagina(paginaActual - 1)">
                ◀ Anterior
            </button>
            <span class="text-white fw-bold fs-5">
                Página <span style="color: #ffe81f;">@paginaActual</span> de @totalPaginas
            </span>
            <button class="btn btn-outline-warning fw-bold px-4 py-2"
                    disabled="@(!tieneSiguiente)"
                    @onclick="() => CambiarPagina(paginaActual + 1)">
                Siguiente ▶
            </button>
        </div>
    }
</div>

@code {
    private List<CharacterDto>? personajes;
    private bool cargando = true;
    private string? mensajeError;
    private int paginaActual = 1;
    private bool tieneSiguiente = false;
    private bool tieneAnterior = false;
    private int totalPaginas = 1;

    protected override async Task OnInitializedAsync()
    {
        // 🔒 Candado de seguridad: si no está autenticado, mandar a login
        if (!UserState.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await CargarPersonajes();
    }

    private async Task CargarPersonajes()
    {
        cargando = true;
        mensajeError = null;

        try
        {
            // Se envía la página actual en la petición
            var respuesta = await Http.GetFromJsonAsync<SwapiResponseDto>($"api/Character/Personajes?page={paginaActual}");
            personajes = respuesta?.Results ?? new();

            // Si Next tiene texto, hay siguiente página, si es null, es última página
            tieneSiguiente = !string.IsNullOrEmpty(respuesta?.Next);

            // Si Previous tiene texto, hay página anterior, si es null, es primer página
            tieneAnterior = !string.IsNullOrEmpty(respuesta?.Previous);

            totalPaginas = (int)Math.Ceiling((respuesta?.Count ?? 0) / 10.0);
        }
        catch (Exception ex)
        {
            mensajeError = "No se pudieron cargar los personajes: " + ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CambiarPagina(int nuevaPagina)
    {
        if (nuevaPagina >= 1)
        {
            paginaActual = nuevaPagina;
            await CargarPersonajes();
        }
    }

    private string ObtenerIdDeUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return "1";
        return url.TrimEnd('/').Split('/').Last();
    }
}
