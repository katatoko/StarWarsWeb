@page "/"

<PageTitle>Star Wars - Portal Galáctico</PageTitle>

<div class="p-5 text-white text-center rounded-3 shadow-lg" style="background: linear-gradient(135deg, #0d0d0d 0%, #1a1a1a 100%); border: 1px solid #ffe81f;">
    <h1 class="display-4 fw-bold" style="color: #ffe81f; letter-spacing: 3px;">STAR WARS WEB</h1>
    <p class="lead mt-3" style="color: #d4d4d8;">
        Bienvenido al portal de consulta de los Archivos Jedi de personajes.
    </p>
    <hr class="my-4 border-secondary" />
    <div class="d-flex justify-content-center gap-3 flex-wrap">
        <a href="/characters" class="btn btn-lg fw-bold px-4" style="background-color: #ffe81f; color: #000;">
            🛸 Explorar Personajes
        </a>
        <a href="/login" class="btn btn-outline-warning btn-lg fw-bold px-4">
            🔐 Iniciar Sesión / Registro
        </a>
    </div>
</div>
